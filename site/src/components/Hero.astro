---
import Icon from './Icon.astro';
import LoopVideo from './LoopVideo.astro';
import { settings, home } from '../lib/content';
const h = home.hero;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <LoopVideo id="hero-video" src={h.video} srcSmall={h.video.replace(/\.mp4$/, '-sm.mp4')} poster={h.poster} label={h.videoAlt} />
  </div>
  <div class="hero-shade"></div>
  <div class="steam" aria-hidden="true"></div>
  <div class="wrap hero-body">
    <h1 id="hero-title">{h.headline}</h1>
    <p class="lead">{h.lead}</p>
    <div class="cta-pair">
      <a class="btn btn-brass" href="#quote">{h.quoteLabel}</a>
      <a class="btn btn-stone" href={settings.phoneHref}><Icon name="phone" /><span>Call <span class="tnum">{settings.phone}</span></span></a>
    </div>
    <nav class="hero-route" aria-label="The four rooms">
      {home.circuit.rooms.map((r, i) => <a href={`#${r.id}`}><span class="num">0{i + 1}</span>{r.name}</a>)}
    </nav>
    <div class="hero-foot">
      <div class="hero-cap">
        <button class="pause" type="button" data-pause-for="hero-video" data-state="paused" aria-label="Play background video">
          <span data-icon="pause"><Icon name="pause" /></span>
          <span data-icon="play"><Icon name="play" /></span>
        </button>
        <span>{h.videoCaption}</span>
      </div>
      <ul class="trust">
        {home.trust.map((t, i) => (
          <li>
            <strong>{i === 0 && <Icon name="check" />}{t.title}</strong>
            {t.text && <span>{t.text}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
