---
import Icon from './Icon.astro';
import { settings, home } from '../lib/content';
const h = home.hero;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-media" aria-hidden="true">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.webp">
        <source src="/media/hero-loop.mp4" media="(min-width: 48rem)" type="video/mp4" />
        <source src="/media/hero-loop-mobile.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-kicker">{h.subhead}</p>
      <h1 id="hero-title">{h.headline}</h1>
      <div class="hero-bottom">
        <p class="hero-lead">{h.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-sky" href="#quote">{h.quoteLabel}</a>
          <a class="btn btn-outline-light" href={settings.phoneHref}><Icon name="phone" /><span>Call <span class="tnum">{settings.phone}</span></span></a>
        </div>
      </div>
      <button class="hero-pause" type="button" aria-label="Pause hero video">Pause video</button>
      <p class="hero-caption">3D design visualization</p>
    </div>
  </div>

  <div class="wrap titleblock" role="list" aria-label="Why choose Island Life">
    {home.trust.map((t) => (
      <div role="listitem">
        <p><strong>{t.title}</strong>{t.text && <span>{t.text}</span>}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pauseBtn = document.querySelector<HTMLButtonElement>('.hero-pause');
  let userPaused = false;
  const label = () => {
    if (!pauseBtn || !heroVideo) return;
    pauseBtn.textContent = heroVideo.paused ? 'Play video' : 'Pause video';
    pauseBtn.setAttribute('aria-label', heroVideo.paused ? 'Play hero video' : 'Pause hero video');
  };
  const syncMotion = () => {
    if (!heroVideo) return;
    if (reducedMotion.matches || userPaused) heroVideo.pause();
    else heroVideo.play().catch(() => {});
  };
  heroVideo?.addEventListener('play', label);
  heroVideo?.addEventListener('pause', label);
  pauseBtn?.addEventListener('click', () => { userPaused = !(heroVideo?.paused); syncMotion(); });
  syncMotion();
  reducedMotion.addEventListener('change', syncMotion);
  document.addEventListener('visibilitychange', () => {
    if (!heroVideo) return;
    if (document.hidden) heroVideo.pause();
    else syncMotion();
  });
</script>
