---
import Icon from './Icon.astro';
import { settings, interests } from '../lib/content';

// The quote request form and its submit script. `surface` is the background it sits on: dark gets the yellow button, light the blue one.
interface Props { surface?: 'dark' | 'light' }
const { surface = 'dark' } = Astro.props;
const { phone, phoneHref, quote } = settings;
// {phone} in the error text becomes a call link. A sent request takes the visitor to the thank-you page.
const errorParts = quote.errorText.split('{phone}');
const thankYouHref = '/thank-you/';
---
<form class="estimate-form" novalidate method="post" action="/api/quote" data-thanks={thankYouHref} data-label={quote.submitLabel} data-pending-label={quote.submitPendingLabel}>
  <p class="estimate-form__required">* Required</p>
  <div class="form-row">
    <label>
      <span>Name *</span>
      <input name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required placeholder="Jane Smith" />
    </label>
    <label>
      <span>ZIP code *</span>
      <input name="zipCode" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" title="A 5-digit ZIP code, for example 77377" maxlength="10" required placeholder="77377" />
    </label>
  </div>
  <div class="form-row">
    <label>
      <span>Email address *</span>
      <input name="email" type="email" autocomplete="email" maxlength="320" required placeholder="jane@example.com" />
    </label>
    <label>
      <span>Phone number *</span>
      <input name="phone" type="tel" autocomplete="tel" maxlength="40" required placeholder="(832) 555-0123" />
    </label>
  </div>
  <label>
    <span>I’m interested in *</span>
    <select name="interest" required>
      <option value="" disabled selected>Select a project</option>
      {interests.map((interest) => <option value={interest}>{interest}</option>)}
    </select>
  </label>
  <label>
    <span>Tell us about your project (optional)</span>
    <textarea name="message" rows="3" maxlength="2000" placeholder="A pool and spa, a shaded patio, room for family dinners…"></textarea>
  </label>
  <label class="hp-field" aria-hidden="true">
    <span>Leave this empty</span>
    <input name="website" type="text" tabindex="-1" autocomplete="off" />
  </label>
  <p class="form-error" role="alert" hidden>{errorParts.map((part, i) => <Fragment>{i > 0 && <a href={phoneHref}>{phone}</a>}{part}</Fragment>)}</p>
  <div class="estimate-form__submit">
    <button class:list={['button', surface === 'light' ? 'button--dark' : 'button--light']} type="submit">
      <span class="button__label">{quote.submitLabel}</span>
      <span class="button__wash" aria-hidden="true"></span>
      <Icon name="arrow-right" size={18} />
      <Icon name="loader-circle" size={18} class="spin" />
    </button>
    <p>{quote.note}</p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.estimate-form').forEach((form) => {
    const error = form.querySelector<HTMLElement>('.form-error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector('.button__label')!;
    const [arrow, spinner] = submit.querySelectorAll<SVGElement>(':scope > svg');

    const setPending = (pending: boolean) => {
      submit.disabled = pending;
      submitLabel.textContent = pending ? form.dataset.pendingLabel! : form.dataset.label!;
      arrow.style.display = pending ? 'none' : '';
      spinner.style.display = pending ? '' : 'none';
    };
    setPending(false);

    // Browser bubbles vanish and say nothing near the field, so each bad field gets its own message and the first one takes focus.
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input:not([tabindex]), select, textarea'));
    const clearField = (field: HTMLElement) => {
      field.removeAttribute('aria-invalid');
      field.removeAttribute('aria-describedby');
      field.parentElement?.querySelector('.field-error')?.remove();
    };
    const messageFor = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      if (field.validity.valueMissing) return field instanceof HTMLSelectElement ? 'Choose a project.' : 'This field is required.';
      if (field.validity.typeMismatch && field.type === 'email') return 'Enter a valid email address, like jane@example.com.';
      if (field.validity.tooShort) return 'Enter at least 2 characters.';
      return field.title || 'Check this field.';
    };
    fields.forEach((field) => {
      field.addEventListener('input', () => clearField(field));
      field.addEventListener('change', () => clearField(field));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      fields.forEach(clearField);
      const invalid = fields.filter((field) => !field.checkValidity());
      if (invalid.length) {
        invalid.forEach((field, i) => {
          const note = document.createElement('small');
          note.className = 'field-error';
          note.id = `${field.name}-error-${i}`;
          note.textContent = messageFor(field);
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', note.id);
          field.parentElement?.append(note);
        });
        invalid[0].focus();
        return;
      }
      setPending(true);
      let leaving = false;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.reference) throw new Error(`Quote request failed (${response.status})`);
        form.reset();
        // The thank-you page is where a visitor lands after a request, so it is also where conversions are counted.
        leaving = true;
        window.location.assign(form.dataset.thanks!);
      } catch (err) {
        console.error(err);
        error.hidden = false;
      } finally {
        // Keep the button busy while the browser leaves for the thank-you page, so a second click cannot send the request twice.
        if (!leaving) setPending(false);
      }
    });
    // Coming back with the Back button restores the page as it was left.
    window.addEventListener('pageshow', () => setPending(false));
  });
</script>
