---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const d = home.design;
---
<section class="design" aria-labelledby="design-title">
  <div class="wrap design-grid">
    <div class="design-heading">
      <h2 id="design-title">{d.title}</h2>
      <p>{d.text}</p>
      <a class="btn btn-sky" href="#quote">Get my 3D design</a>
    </div>
    <figure class="design-figure">
      <div class="reel">
        <video class="design-video" playsinline preload="none" poster="/media/design-poster.webp" aria-label={d.videoLabel}>
          <source src="/media/island-life-design.mp4" type="video/mp4" />
        </video>
        <button class="play" type="button" aria-label={`Play video: ${d.videoLabel}`}>
          <span class="disc"><Icon name="play" /></span>
          <span class="lbl">Watch the design come to life</span>
        </button>
        <p class="video-status" role="status"></p>
      </div>
      <figcaption><span>{d.caption}</span><span>Island Life Custom Pools</span></figcaption>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.reel').forEach((reel) => {
    const video = reel.querySelector<HTMLVideoElement>('video');
    const button = reel.querySelector<HTMLButtonElement>('.play');
    const status = reel.querySelector<HTMLElement>('.video-status');
    button?.addEventListener('click', async () => {
      if (!video) return;
      try {
        video.controls = true;
        await video.play();
        button.remove();
        video.focus();
      } catch {
        video.controls = true;
        if (status) status.textContent = 'The video could not start. Try the native video controls or call us for a design consult.';
      }
    });
  });
</script>
