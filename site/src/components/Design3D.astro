---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const d = home.design;
---
<section class="design section tiled" aria-labelledby="design-title">
  <div class="wrap design-grid">
    <div class="design-copy">
      <h2 id="design-title">{d.title}</h2>
      <p class="lead">{d.text}</p>
      <a class="btn btn-brass" href="#quote">Get my 3D design</a>
    </div>
    <figure>
      <div class="player" data-src={d.videoSrc} data-poster={d.poster}>
        <img src={d.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
        <button class="play" type="button" aria-label={d.videoLabel}>
          <span class="disc"><Icon name="play" /></span>
          <span>{d.videoLabel}</span>
        </button>
      </div>
      <figcaption class="player-cap">{d.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.player').forEach((player) => {
    const btn = player.querySelector<HTMLButtonElement>('.play');
    btn?.addEventListener('click', () => {
      const v = document.createElement('video');
      v.src = player.dataset.src ?? '';
      v.poster = player.dataset.poster ?? '';
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      player.replaceChildren(v);
      v.focus();
    });
  });
</script>
