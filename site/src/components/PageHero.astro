---
import Icon from './Icon.astro';
import { settings } from '../lib/content';
interface Props { crumbs: { label: string; href?: string }[]; title: string; lead?: string; image?: string; imageAlt?: string; actions?: boolean }
const { crumbs, title, lead, image, imageAlt = '', actions = true } = Astro.props;
---
<section class="page-hero">
  <div class="wrap page-hero-grid">
    <div class="page-hero-copy">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {actions && (
        <div class="cta-pair">
          <a class="btn btn-sun" href="#quote">Request a free quote</a>
          <a class="btn btn-outline-dark" href={settings.phoneHref}><Icon name="phone" /><span class="tnum">{settings.phone}</span></a>
        </div>
      )}
    </div>
    {image && <img class="page-hero-img" src={image} alt={imageAlt} width="1600" height="900" fetchpriority="high" />}
  </div>
</section>
