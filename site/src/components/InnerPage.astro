---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import Estimate from '../sections/Estimate.astro';
import Footer from '../sections/Footer.astro';
import { pools as content } from '../lib/content';

const slug = 'pools';
---
<Base title={content.seoTitle} description={content.seoDescription}>
  <Header solid />
  <main id="top" class="inner-page">
    <section class="inner-hero" aria-labelledby="inner-title">
      <div class="page-shell inner-hero__grid">
        <div class="inner-hero__copy">
          <p class="inner-hero__breadcrumb"><a href="/">{content.homeLabel}</a><span aria-hidden="true">/</span>{content.eyebrow}</p>
          <h1 id="inner-title">{content.title}{content.italicTitle && <>{' '}<br /><em>{content.italicTitle}</em></>}</h1>
          <p class="inner-hero__intro">{content.introduction}</p>
          <a class="button button--dark" href="#quote">
            <span class="button__label">{content.heroCta}</span>
            <span class="button__wash" aria-hidden="true"></span>
            <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
          </a>
        </div>
        <figure class="inner-hero__visual">
          <img src={content.heroImage} alt={content.heroImageAlt} fetchpriority="high" />
        </figure>
      </div>
      <a class="inner-hero__scroll" href={`#${slug}-overview`}>
        {content.scrollLabel} <Icon name="arrow-down" size={17} />
      </a>
    </section>

    <section class="inner-overview section" id={`${slug}-overview`} aria-labelledby="overview-title">
      <div class="page-shell inner-overview__grid">
        <div>
          <p class="section-label">{content.overviewLabel}</p>
          <h2 id="overview-title">{content.overviewTitle}</h2>
        </div>
        <div class="inner-overview__content">
          <p class="inner-overview__lede">{content.overview}</p>
          <ul class="inner-considerations">
            {content.considerations.map((item) => (
              <li><Icon name="check" size={20} strokeWidth={1.6} /><span>{item}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="inner-detail" aria-labelledby="detail-title">
      <div class="page-shell inner-detail__grid">
        <figure class="inner-detail__visual">
          <img src={content.detailImage} alt={content.detailImageAlt} loading="lazy" />
        </figure>
        <div class="inner-detail__copy">
          <p class="section-label section-label--light">{content.detailEyebrow}</p>
          <h2 id="detail-title">{content.detailTitle}</h2>
          <p>{content.detail}</p>
          <a class="text-link text-link--light" href="#quote">{content.detailLink} <Icon name="arrow-up-right" size={18} /></a>
        </div>
      </div>
    </section>

    <Estimate />
  </main>
  <Footer />
</Base>
