---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const p = home.paths;
---
<section class="section" aria-labelledby="paths-title">
  <div class="wrap">
    <div class="section-head"><h2 id="paths-title">{p.title}</h2></div>
    <div class="paths-grid">
      <article class="path">
        <h3>{p.first.title}</h3>
        <p class="lead">{p.first.text}</p>
        <blockquote>
          <p>“{p.first.quote}”</p>
          <cite>{p.first.by}</cite>
        </blockquote>
        <a class="textlink" href="#quote" data-interest="Pool">Start my pool<Icon name="arrow" /></a>
      </article>
      <article class="path">
        <h3>{p.upgrade.title}</h3>
        <p class="lead">{p.upgrade.text}</p>
        <ul class="chips">
          {p.upgrade.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
        <a class="textlink" href="#quote">Plan my upgrade<Icon name="arrow" /></a>
      </article>
    </div>
  </div>
</section>
