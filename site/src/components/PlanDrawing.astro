---
interface Props { id: string; viewBox?: string; draw?: boolean; label?: string }
const { id, viewBox = '0 0 800 640', draw = false, label = 'Illustrative plan of a backyard with a pool, patio cover, and outdoor kitchen' } = Astro.props;
const wave = (y: number) => {
  let d = `M 100 ${y}`;
  for (let i = 0; i < 14; i++) d += ` q 30 ${i % 2 ? 7 : -7} 60 0`;
  return d;
};
const ys = Array.from({ length: 14 }, (_, i) => 292 + i * 19);
const poolPath =
  'M 262 340 C 262 308, 340 296, 410 304 C 480 312, 530 336, 596 322 C 656 310, 692 344, 686 404 C 680 466, 636 520, 560 528 C 484 536, 436 500, 366 508 C 296 516, 252 490, 250 440 C 248 398, 262 372, 262 340 Z';
const ledgePath = 'M 274 342 C 274 322, 336 314, 392 320 C 430 324, 440 344, 400 356 C 344 370, 298 376, 280 370 Z';
---
<svg class:list={['plan-svg', { draw }]} viewBox={viewBox} role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`${id}-hatch`} width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="12" stroke="var(--lagoon-800)" stroke-opacity=".28" stroke-width="1.5"/></pattern>
    <pattern id={`${id}-rafters`} width="18" height="18" patternUnits="userSpaceOnUse"><line x1="0" y1="0" x2="0" y2="18" stroke="var(--lagoon-800)" stroke-opacity=".5" stroke-width="1.5"/></pattern>
    <pattern id={`${id}-pavers`} width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" fill="none" stroke="var(--lagoon-800)" stroke-opacity=".13" stroke-width="1"/></pattern>
    <clipPath id={`${id}-pool`}><path d={poolPath}/></clipPath>
    <linearGradient id={`${id}-water`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--aqua-300)"/><stop offset="1" stop-color="var(--aqua-500)"/></linearGradient>
  </defs>

  <g class="g-lot">
    <rect class="out" pathLength="1" x="20" y="20" width="760" height="600" fill="none" stroke="var(--lagoon-800)" stroke-width="1.5"/>
  </g>

  <g class="g-deck">
    <rect x="60" y="250" width="680" height="340" rx="14" fill="var(--ground-2)"/>
    <rect x="60" y="250" width="680" height="340" rx="14" fill={`url(#${id}-pavers)`}/>
  </g>

  <g class="g-house">
    <rect class="out" pathLength="1" x="20" y="20" width="760" height="110" fill="var(--ground-3)" stroke="var(--lagoon-800)" stroke-width="2.5"/>
    <rect x="20" y="20" width="760" height="110" fill={`url(#${id}-hatch)`}/>
  </g>

  <g class="g-kitchen">
    <rect class="out fill-hl" pathLength="1" x="500" y="142" width="220" height="40" fill="#fff" stroke="var(--lagoon-800)" stroke-width="2"/>
    <rect class="fill-hl" x="520" y="206" width="180" height="38" fill="#fff" stroke="var(--lagoon-800)" stroke-width="2"/>
    <rect x="545" y="148" width="56" height="28" fill="var(--ground-3)" stroke="var(--lagoon-800)" stroke-width="1.5"/>
    <circle cx="562" cy="162" r="6" fill="none" stroke="var(--lagoon-800)" stroke-width="1.5"/>
    <circle cx="584" cy="162" r="6" fill="none" stroke="var(--lagoon-800)" stroke-width="1.5"/>
    <rect x="640" y="150" width="36" height="24" rx="5" fill="var(--aqua-100)" stroke="var(--lagoon-800)" stroke-width="1.5"/>
    {[545, 590, 635, 680].map((x) => <circle cx={x} cy="262" r="9" fill="#fff" stroke="var(--lagoon-800)" stroke-width="1.5"/>)}
  </g>

  <g class="g-patio">
    <rect class="out fill-hl" pathLength="1" x="130" y="130" width="330" height="130" fill="#fff" fill-opacity=".7" stroke="var(--lagoon-800)" stroke-width="2.5"/>
    <rect x="130" y="130" width="330" height="130" fill={`url(#${id}-rafters)`}/>
    {[130, 290, 450].map((x) => <rect x={x - 6} y="254" width="12" height="12" fill="var(--lagoon-800)"/>)}
  </g>

  <g class="g-fire">
    <circle cx="140" cy="350" r="28" fill="var(--ground-3)" stroke="var(--lagoon-800)" stroke-width="2"/>
    <circle cx="140" cy="350" r="12" fill="var(--sun)" stroke="var(--lagoon-800)" stroke-width="1.5"/>
    {[[88, 350], [192, 350], [140, 298], [140, 402]].map(([x, y]) => <circle cx={x} cy={y} r="9" fill="#fff" stroke="var(--lagoon-800)" stroke-width="1.5"/>)}
  </g>

  <g class="g-pool">
    <circle class="out" pathLength="1" cx="208" cy="466" r="42" fill="var(--aqua-300)" stroke="var(--lagoon-800)" stroke-width="2.5"/>
    <circle cx="208" cy="466" r="28" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="2"/>
    <path d={poolPath} fill="none" stroke="#fff" stroke-width="16" stroke-linejoin="round"/>
    <g class="water">
      <g clip-path={`url(#${id}-pool)`}>
        <rect x="230" y="285" width="470" height="260" fill={`url(#${id}-water)`}/>
        <path d={ledgePath} fill="var(--aqua-100)" fill-opacity=".9"/>
        <g class="swell" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="2" stroke-linecap="round">
          {ys.map((y) => <path d={wave(y)} />)}
        </g>
        <g class="swell b" fill="none" stroke="var(--lagoon-600)" stroke-opacity=".22" stroke-width="1.5" stroke-linecap="round">
          {ys.map((y) => <path d={wave(y + 9)} />)}
        </g>
      </g>
    </g>
    <path class="out" pathLength="1" d={poolPath} fill="none" stroke="var(--lagoon-800)" stroke-width="3" stroke-linejoin="round"/>
  </g>

  <g class="g-dim" stroke="var(--lagoon-800)" stroke-width="1.5" fill="none">
    <path d="M 238 584 H 686 M 238 574 V 594 M 686 574 V 594"/>
    <rect x="436" y="572" width="52" height="24" rx="4" fill="var(--ground-2)" stroke="none"/>
    <text x="462" y="590" text-anchor="middle" font-family="Figtree Variable, sans-serif" font-size="16" font-weight="700" fill="var(--lagoon-800)" stroke="none">36′</text>
  </g>

  <g class="g-north" transform="translate(738 548)" stroke="var(--lagoon-800)" stroke-width="1.5" fill="none">
    <circle r="22"/>
    <path d="M 0 -16 L 7 10 L 0 5 L -7 10 Z" fill="var(--lagoon-800)"/>
  </g>
</svg>
