---
import { settings } from '../lib/content';
---
<footer class="footer on-deep">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a class="brand" href="/" aria-label={`${settings.name}, home`}>
          <img src={settings.logo} alt={settings.name} width="114" height="72" />
        </a>
        <p class="footer-tag">Bring your vacation dreams home</p>
        <a class="footer-phone tnum" href={settings.phoneHref}>{settings.phone}</a>
      </div>
      <div>
        <h2>Get in touch</h2>
        <ul class="hours tnum">
          {settings.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}
        </ul>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>{settings.infoLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Follow</h2>
        <ul>{settings.social.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{settings.copyright}</span>
      <span>Tomball, Cypress, The Woodlands, Houston</span>
      <a href={settings.privacyHref}>Privacy policy</a>
    </div>
  </div>
</footer>
