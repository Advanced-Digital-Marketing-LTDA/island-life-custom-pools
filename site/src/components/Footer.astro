---
import { settings } from '../lib/content';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label={`${settings.name}, home`} style="display:inline-block">
          {settings.logo ? <img src={settings.logo} alt={settings.name} width="114" height="72" /> : <span class="wordmark">Island Life<small>Custom Pools</small></span>}
        </a>
        <p class="footer-tag">Bring your vacation dreams home</p>
      </div>
      <div>
        <h3>Get in touch</h3>
        <ul class="hours tnum">
          {settings.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}
        </ul>
        <p style="margin-top:1rem"><a class="tnum" href={settings.phoneHref} style="font-size:1.25rem">{settings.phone}</a></p>
      </div>
      <div>
        <h3>Info</h3>
        <ul>{settings.infoLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Follow</h3>
        <ul>{settings.social.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{settings.copyright}</span>
      <a href={settings.privacyHref}>Privacy policy</a>
    </div>
  </div>
</footer>
