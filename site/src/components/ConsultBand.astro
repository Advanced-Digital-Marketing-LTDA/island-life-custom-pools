---
import { settings, home } from '../lib/content';
interface Props { title?: string; text?: string; quoteHref?: string; quoteLabel?: string }
const d = home.discount;
const { title = d.title, text = d.text, quoteHref = '#quote', quoteLabel = d.linkLabel } = Astro.props;
---
<section class="cta-band on-deep" aria-labelledby="discount-title">
  <div class="wrap cta-in">
    <h2 id="discount-title">{title}</h2>
    <p>{text}</p>
    <div class="cta-pair">
      <a class="btn btn-sun" href={quoteHref}>{quoteLabel}</a>
      <a class="btn btn-outline-light" href={settings.phoneHref}><span class="tnum">{settings.phone}</span></a>
    </div>
  </div>
</section>
