---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const s = home.services;
const images: Record<string, string> = {
  pool: '/media/service-pool.webp',
  patio: '/media/service-patio.webp',
  kitchen: '/media/service-kitchen.webp',
};
---
<section class="services-section section" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services-heading">
      <h2 id="services-title">{s.title}</h2>
    </div>
    <div class="services">
      {s.items.map((i) => (
        <article class="service">
          <figure class="service-media">
            <img src={images[i.id]} alt={`${i.title} shown in an Island Life 3D backyard design`} loading="lazy" width="1600" height="900" />
            <figcaption>3D design visualization</figcaption>
          </figure>
          <div class="service-copy">
            <h3>{i.title}</h3>
            <p>{i.text}</p>
            <a class="textlink" href={i.href}>{i.linkLabel}<Icon name="arrow" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
