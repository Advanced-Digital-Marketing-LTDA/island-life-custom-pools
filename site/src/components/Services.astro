---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const s = home.services;
const images: Record<string, string> = {
  pool: '/media/service-pool.webp',
  patio: '/media/service-patio.webp',
  kitchen: '/media/service-kitchen.webp',
};
---
<section class="services" aria-labelledby="services-title">
  <h2 id="services-title" class="sr-only">{s.title}</h2>
  <div class="services-grid">
    {s.items.map((i) => (
      <a class="panel" href={i.href}>
        <img src={images[i.id]} alt="" loading="lazy" width="1600" height="756" />
        <span class="panel-copy">
          <h3>{i.title}</h3>
          <p>{i.text}</p>
          <span class="panel-link">{i.linkLabel}<Icon name="arrow" /></span>
        </span>
      </a>
    ))}
  </div>
  <p class="wrap services-note">All images on this site are 3D design visualizations, not photographs of finished projects.</p>
</section>
