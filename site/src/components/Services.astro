---
import PlanDrawing from './PlanDrawing.astro';
import Icon from './Icon.astro';
import { home } from '../lib/content';
const s = home.services;
const crops: Record<string, string> = {
  pool: '120 250 640 400',
  patio: '95 100 420 262',
  kitchen: '470 112 290 181',
};
---
<section class="section" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head"><h2 id="services-title">{s.title}</h2></div>
    <div class="services">
      {s.items.map((i) => (
        <article class="service">
          <div class="sheet"><PlanDrawing id={`svc-${i.id}`} viewBox={crops[i.id]} label="" /></div>
          <div class="service-copy">
            <h3>{i.title}</h3>
            <p>{i.text}</p>
            <a class="textlink" href={i.href}>{i.linkLabel}<Icon name="arrow" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
