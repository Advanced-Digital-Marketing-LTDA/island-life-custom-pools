---
import Icon from './Icon.astro';
import LoopVideo from './LoopVideo.astro';
import { home } from '../lib/content';
const c = home.circuit;
// Every photo ships as a -1600 and a -800 webp twin; the -800 serves phones.
const small = (p: string) => p.replace('-1600.webp', '-800.webp');
const set = (p: string) => (p.includes('-1600.webp') ? `${small(p)} 800w, ${p} 1600w` : undefined);
---
<section class="section circuit-head tiled" aria-labelledby="circuit-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="circuit-title">{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <ul class="room-nav">
        {c.rooms.map((r, i) => <li><a href={`#${r.id}`}><span class="tnum">0{i + 1}</span> {r.name}</a></li>)}
      </ul>
    </div>
  </div>
</section>

{c.rooms.map((r, i) => (
  <section class="room" id={r.id} data-side={i % 2 ? 'right' : 'left'} aria-labelledby={`${r.id}-title`}>
    <div class="room-bg">
      <img src={r.photo} srcset={set(r.photo)} sizes="100vw" alt={r.alt} width="1600" height="1067" loading="lazy" decoding="async" />
    </div>
    <div class="wrap room-body">
      <div class="room-main">
        <div class="plaque room-plaque">
          <div class="room-tag"><span class="num">0{i + 1}</span><h2 id={`${r.id}-title`}>{r.name}</h2></div>
          <p class="room-service">{r.title}</p>
          <p>{r.text}</p>
          <a class="btn btn-stone" href={r.href}>{r.linkLabel}<Icon name="arrow" /></a>
        </div>
        {r.video && r.gallery.length > 0 && (
          <ul class="room-strip">
            {r.gallery.map((g) => (
              <li><img src={g.photo} srcset={set(g.photo)} sizes="(min-width: 60em) 9rem, 30vw" alt={g.alt} width="1600" height="1067" loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        )}
      </div>
      {r.video ? (
        <div class="vframe">
          <LoopVideo id={`${r.id}-video`} src={r.video} poster={r.videoPoster} label={r.videoAlt} preload="none" />
          <button class="pause" type="button" data-pause-for={`${r.id}-video`} data-state="paused" aria-label="Play background video">
            <span data-icon="pause"><Icon name="pause" /></span>
            <span data-icon="play"><Icon name="play" /></span>
          </button>
        </div>
      ) : r.gallery.length > 0 && (
        <ul class="room-strip">
          {r.gallery.map((g) => (
            <li><img src={g.photo} srcset={set(g.photo)} sizes="(min-width: 60em) 20vw, 30vw" alt={g.alt} width="1600" height="1067" loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      )}
    </div>
  </section>
))}
