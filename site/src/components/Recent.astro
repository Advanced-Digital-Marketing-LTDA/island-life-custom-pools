---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const r = home.recent;
---
<section class="section tiled" aria-labelledby="recent-title">
  <div class="wrap">
    <div class="recent-head">
      <h2 id="recent-title">{r.title}</h2>
      <a class="btn btn-line" href={r.followHref} rel="noopener">{r.followLabel}<Icon name="out" /></a>
    </div>
    <ul class="posts">
      {r.items.map((i) => (
        <li>
          <a href={i.href} rel="noopener">
            <span class="kind">{i.kind}</span>
            <span class="ptitle">{i.image && <img src={i.image} alt="" loading="lazy" width="72" height="72" />}{i.title}</span>
            <Icon name="out" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
