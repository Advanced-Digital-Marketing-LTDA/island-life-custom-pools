---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { settings, linkTo } from '../lib/content';
import { homePrefix as prefixOf, pathOf } from '../lib/nav';

interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const pathname = pathOf(Astro.url);
const homePrefix = prefixOf(Astro.url);

const { phone, phoneHref } = settings;
const navItems = settings.nav.map((item) => ({ ...item, target: linkTo(Astro.url, item.href) }));
---
<header class:list={['site-header', { 'site-header--solid': solid }]}>
  <nav class="site-header__inner" aria-label="Main navigation">
    <a class="site-header__brand" href={`${homePrefix}#top`} aria-label={`${settings.name} home`}>
      <Brand />
    </a>
    <div class="site-header__links">
      {navItems.map((item) => <a href={item.target} aria-current={pathname === item.target ? 'page' : undefined}>{item.label}</a>)}
    </div>
    <a class="button button--light site-header__cta" href={`${homePrefix}#quote`}>
      <span class="button__label">{settings.headerCta}</span>
      <span class="button__wash" aria-hidden="true"></span>
      <Icon name="arrow-up-right" size={17} strokeWidth={1.7} />
    </a>
    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={25} strokeWidth={1.5} />
    </button>
  </nav>
</header>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu" aria-hidden="true" inert>
  <div class="mobile-menu__top">
    <Brand />
    <button class="menu-toggle menu-toggle--close" type="button" aria-label="Close navigation menu" tabindex="-1">
      <Icon name="x" size={26} strokeWidth={1.4} />
    </button>
  </div>
  <div class="mobile-menu__links">
    {navItems.map((item, index) => <a href={item.target} aria-current={pathname === item.target ? 'page' : undefined} tabindex="-1"><span>0{index + 1}</span>{item.label}</a>)}
  </div>
  <div class="mobile-menu__bottom">
    <a class="button button--light" href={`${homePrefix}#quote`} tabindex="-1">
      <span class="button__label">{settings.menuCta}</span>
      <span class="button__wash" aria-hidden="true"></span>
      <Icon name="arrow-up-right" size={18} />
    </a>
    <a href={phoneHref} tabindex="-1">{phone}</a>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const brand = header.querySelector<HTMLElement>('.brand')!;
  const trigger = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const closeButton = menu.querySelector<HTMLButtonElement>('.menu-toggle--close')!;
  const controls = menu.querySelectorAll<HTMLElement>('a[href], button');

  const onScroll = () => {
    const scrolled = window.scrollY > 48;
    header.classList.toggle('is-scrolled', scrolled);
    brand.classList.toggle('brand--compact', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  let previousOverflow = '';
  let focusFrame = 0;
  const onKeyDown = (event: KeyboardEvent) => {
    if (event.key === 'Escape') setOpen(false);
    if (event.key === 'Tab') {
      const focusable = menu.querySelectorAll<HTMLElement>('a[href], button:not([tabindex="-1"])');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  };

  function setOpen(open: boolean) {
    if (open === menu.classList.contains('is-open')) return;
    menu.classList.toggle('is-open', open);
    header.classList.toggle('menu-is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menu.inert = !open;
    trigger.setAttribute('aria-expanded', String(open));
    controls.forEach((el) => { el.tabIndex = open ? 0 : -1; });
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      focusFrame = requestAnimationFrame(() => closeButton.focus());
      window.addEventListener('keydown', onKeyDown);
    } else {
      cancelAnimationFrame(focusFrame);
      document.body.style.overflow = previousOverflow;
      window.removeEventListener('keydown', onKeyDown);
      trigger.focus();
    }
  }

  trigger.addEventListener('click', () => setOpen(true));
  closeButton.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('.mobile-menu__links a, .mobile-menu__bottom .button').forEach((el) => el.addEventListener('click', () => setOpen(false)));
</script>
