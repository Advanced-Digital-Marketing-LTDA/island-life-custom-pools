---
import Icon from './Icon.astro';
import { settings } from '../lib/content';
const primary = settings.nav.filter((n) => n.primary);
---
<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${settings.name}, home`}>
      {settings.logo
        ? <img src={settings.logo} alt={settings.name} width="114" height="72" />
        : <span class="wordmark">Island Life<small>Custom Pools</small></span>}
    </a>
    <nav class="nav-inline" aria-label="Main">
      {primary.map((n) => <a href={n.href}>{n.short || n.label}</a>)}
    </nav>
    <div class="bar-actions">
      <a class="btn btn-stone" href={settings.phoneHref}><Icon name="phone" /><span class="tnum">{settings.phone}</span></a>
      <a class="btn btn-brass" href="#quote">Request a free quote</a>
    </div>
    <button class="menu-btn" type="button" popovertarget="menu" aria-label="Open menu"><Icon name="menu" />Menu</button>
  </div>

  <div id="menu" popover class="menu-panel">
    <div class="menu-top">
      <strong>{settings.name}</strong>
      <button class="menu-close" type="button" popovertarget="menu" popovertargetaction="hide">Close</button>
    </div>
    <div class="menu-actions">
      <a class="btn btn-brass" href="#quote">Request a free quote</a>
      <a class="btn btn-stone" href={settings.phoneHref}><Icon name="phone" /><span class="tnum">{settings.phone}</span></a>
    </div>
    <nav aria-label="Site">
      <ul class="menu-list">
        {settings.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="menu-meta tnum">
      {settings.hours.map((h) => <span>{h.days}: {h.time}</span>)}
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menu = document.getElementById('menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.hidePopover());
  });
  // Focus starts on Close so the keyboard lands inside the panel, and the panel never outlives the layout that shows it.
  menu?.addEventListener('toggle', (e) => {
    if ((e as ToggleEvent).newState === 'open') menu.querySelector<HTMLElement>('.menu-close')?.focus();
  });
  matchMedia('(min-width: 75em)').addEventListener('change', (e) => {
    if (e.matches && menu?.matches(':popover-open')) menu.hidePopover();
  });
  const solid = () => header?.toggleAttribute('data-solid', scrollY > 40);
  addEventListener('scroll', solid, { passive: true });
  solid();
</script>
