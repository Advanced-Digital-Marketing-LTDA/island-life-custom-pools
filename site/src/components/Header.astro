---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { settings, linkTo } from '../lib/content';
import { homePrefix as prefixOf, pathOf } from '../lib/nav';

// hasQuote: the page has its own quote form, so the buttons jump to it instead of to the home page's.
interface Props { solid?: boolean; hasQuote?: boolean }
const { solid = false, hasQuote = false } = Astro.props;
const pathname = pathOf(Astro.url);
const homePrefix = prefixOf(Astro.url);

const { phone, phoneHref } = settings;
const navItems = settings.nav.map((item) => ({ ...item, target: linkTo(Astro.url, item.href) }));
const quoteHref = hasQuote ? '#quote' : `${homePrefix}#quote`;
// pathOf() drops the trailing slash, so compare menu links without theirs.
// A menu item that points at the home page's #areas section gets the cities that have their own page as a submenu,
// taken from Site settings (the same list as the footer), so a new city page shows up here with no extra step.
const cityPages = settings.footer.areas.filter((area) => area.href).map((area) => ({ label: area.name, target: area.href as string }));
const hasCities = (item: { href: string }) => cityPages.length > 0 && /^\/?#areas$/.test(item.href);
const isCurrent = (target: string) => pathname === (target.replace(/\/$/, '') || '/');
---
<header class:list={['site-header', { 'site-header--solid': solid }]}>
  <nav class="site-header__inner" aria-label="Main navigation">
    <a class="site-header__brand" href={`${homePrefix}#top`} aria-label={`${settings.name} home`}>
      <Brand />
    </a>
    <div class="site-header__links">
      {navItems.map((item) => hasCities(item) ? (
        <div class="nav-item">
          <a href={item.target} aria-current={cityPages.some((city) => isCurrent(city.target)) ? 'true' : undefined}>{item.label}</a>
          <button type="button" class="nav-item__toggle" aria-expanded="false" aria-label={`Show ${item.label.toLowerCase()}`}><Icon name="chevron-down" size={16} strokeWidth={1.6} /></button>
          <ul class="nav-sub">
            {cityPages.map((city) => <li><a href={city.target} aria-current={isCurrent(city.target) ? 'page' : undefined}>{city.label}</a></li>)}
          </ul>
        </div>
      ) : <a href={item.target} aria-current={isCurrent(item.target) ? 'page' : undefined}>{item.label}</a>)}
    </div>
    <div class="site-header__actions">
      <a class="site-header__phone" href={phoneHref} aria-label={`Call ${phone}`}>
        <Icon name="phone" size={20} strokeWidth={1.6} /><span>{phone}</span>
      </a>
      <a class="button button--light site-header__cta" href={quoteHref}>
        <span class="button__label">{settings.headerCta}</span>
        <span class="button__wash" aria-hidden="true"></span>
        <Icon name="arrow-up-right" size={17} strokeWidth={1.7} />
      </a>
    </div>
    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <Icon name="menu" size={25} strokeWidth={1.5} />
    </button>
  </nav>
</header>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu" aria-hidden="true" inert>
  <div class="mobile-menu__top">
    <Brand />
    <button class="menu-toggle menu-toggle--close" type="button" aria-label="Close navigation menu" tabindex="-1">
      <Icon name="x" size={26} strokeWidth={1.4} />
    </button>
  </div>
  <div class="mobile-menu__links">
    {navItems.map((item) => hasCities(item) ? (
      <details class="mobile-menu__group" open={cityPages.some((city) => isCurrent(city.target))}>
        <summary>{item.label}<Icon name="chevron-down" size={22} strokeWidth={1.5} /></summary>
        <div class="mobile-menu__sub">
          <a href={item.target} tabindex="-1">All service areas</a>
          {cityPages.map((city) => <a href={city.target} aria-current={isCurrent(city.target) ? 'page' : undefined} tabindex="-1">{city.label}</a>)}
        </div>
      </details>
    ) : <a href={item.target} aria-current={isCurrent(item.target) ? 'page' : undefined} tabindex="-1">{item.label}</a>)}
  </div>
  <div class="mobile-menu__bottom">
    <a class="button button--light" href={quoteHref} tabindex="-1">
      <span class="button__label">{settings.menuCta}</span>
      <span class="button__wash" aria-hidden="true"></span>
      <Icon name="arrow-up-right" size={18} />
    </a>
    <a class="mobile-menu__call" href={phoneHref} tabindex="-1"><Icon name="phone" size={18} strokeWidth={1.6} />Call {phone}</a>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const brand = header.querySelector<HTMLElement>('.brand')!;
  const trigger = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const closeButton = menu.querySelector<HTMLButtonElement>('.menu-toggle--close')!;
  const controls = menu.querySelectorAll<HTMLElement>('a[href], button');

  const onScroll = () => {
    const scrolled = window.scrollY > 48;
    header.classList.toggle('is-scrolled', scrolled);
    brand.classList.toggle('brand--compact', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  let previousOverflow = '';
  let focusFrame = 0;
  const onKeyDown = (event: KeyboardEvent) => {
    if (event.key === 'Escape') setOpen(false);
    if (event.key === 'Tab') {
      const focusable = menu.querySelectorAll<HTMLElement>('a[href], button:not([tabindex="-1"])');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  };

  function setOpen(open: boolean) {
    if (open === menu.classList.contains('is-open')) return;
    menu.classList.toggle('is-open', open);
    header.classList.toggle('menu-is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menu.inert = !open;
    trigger.setAttribute('aria-expanded', String(open));
    controls.forEach((el) => { el.tabIndex = open ? 0 : -1; });
    if (open) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      focusFrame = requestAnimationFrame(() => closeButton.focus());
      window.addEventListener('keydown', onKeyDown);
    } else {
      cancelAnimationFrame(focusFrame);
      document.body.style.overflow = previousOverflow;
      window.removeEventListener('keydown', onKeyDown);
      trigger.focus();
    }
  }

  // The cities submenu opens on hover and focus (CSS); the chevron button also opens it by touch or keyboard, and Escape closes it.
  header.querySelectorAll<HTMLElement>('.nav-item').forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('.nav-item__toggle')!;
    const setSub = (open: boolean) => { item.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => setSub(!item.classList.contains('is-open')));
    item.addEventListener('keydown', (event) => { if (event.key === 'Escape') { setSub(false); toggle.focus(); } });
    document.addEventListener('click', (event) => { if (!item.contains(event.target as Node)) setSub(false); });
  });

  trigger.addEventListener('click', () => setOpen(true));
  closeButton.addEventListener('click', () => setOpen(false));
  menu.querySelectorAll('.mobile-menu__links a, .mobile-menu__bottom .button').forEach((el) => el.addEventListener('click', () => setOpen(false)));
</script>
