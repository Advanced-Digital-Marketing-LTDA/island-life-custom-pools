---
import Icon from './Icon.astro';
import { settings } from '../lib/content';
const primary = settings.nav.filter((n) => n.primary);
const quoteHref = Astro.url.pathname === '/' ? '#quote' : '/#quote';
---
<header class="site-header" data-solid={Astro.url.pathname !== '/' ? '' : undefined}>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${settings.name}, home`}>
      <img src={settings.logo} alt={settings.name} width="114" height="72" />
    </a>
    <nav class="nav-inline" aria-label="Main navigation">
      {primary.map((n) => <a href={n.href} aria-current={Astro.url.pathname === n.href ? 'page' : undefined}>{n.short || n.label}</a>)}
    </nav>
    <div class="bar-actions">
      <a class="btn btn-sun btn-small" href={quoteHref}>Free quote</a>
    </div>
    <button class="menu-btn" type="button" popovertarget="menu" aria-label="Open navigation menu" aria-expanded="false" aria-controls="menu">
      <span>Menu</span><Icon name="menu" />
    </button>
  </div>

  <div id="menu" popover class="menu-panel on-deep">
    <div class="menu-top">
      <span class="menu-brand">Island Life <em>Custom Pools</em></span>
      <button class="menu-close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Close navigation menu">Close</button>
    </div>
    <nav aria-label="Menu navigation">
      <ul class="menu-list">
        {settings.nav.map((n) => <li><a href={n.href}>{n.label}<Icon name="arrow" /></a></li>)}
      </ul>
    </nav>
    <div class="menu-footer">
      <div class="menu-meta tnum">
        {settings.hours.map((h) => <span>{h.days}: {h.time}</span>)}
      </div>
      <div class="menu-actions">
        <a class="btn btn-light" href={quoteHref}>Request a free quote</a>
        <a class="btn btn-outline-light" href={settings.phoneHref}><Icon name="phone" /><span class="tnum">{settings.phone}</span></a>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.getElementById('menu');
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.hidePopover());
  });
  // Modal behaviour: everything behind the panel is inert and the page does not scroll.
  const behind = () => [...document.querySelectorAll<HTMLElement>('.site-header .bar, main, footer, .mobile-bar, .skip')];
  const opener = document.querySelector<HTMLElement>('.menu-btn');
  menu?.addEventListener('beforetoggle', (e) => {
    const open = (e as ToggleEvent).newState === 'open';
    behind().forEach((el) => { el.inert = open; });
    document.documentElement.style.overflow = open ? 'hidden' : '';
    opener?.setAttribute('aria-expanded', String(open));
  });
  menu?.addEventListener('toggle', (e) => {
    if ((e as ToggleEvent).newState === 'open') menu.querySelector<HTMLElement>('.menu-close')?.focus();
    else opener?.focus();
  });
  matchMedia('(min-width: 76rem)').addEventListener('change', (e) => {
    if (e.matches && menu?.matches(':popover-open')) menu.hidePopover();
  });
</script>
