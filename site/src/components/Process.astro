---
import { home } from '../lib/content';
interface Props { steps?: number[] }
const p = home.process;
const { steps = p.steps.map((_, i) => i) } = Astro.props;
const shown = steps.map((i) => p.steps[i]);
---
<section class="process section" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process-heading">
      <h2 id="process-title">{p.title}</h2>
    </div>
    <ol class="steps" style={`--cols:${shown.length}`}>
      {shown.map((s) => (
        <li><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
    <blockquote class="process-quote">
      <p>“{p.quote}”</p>
      <cite>{p.by}</cite>
    </blockquote>
  </div>
</section>
