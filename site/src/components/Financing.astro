---
import { home } from '../lib/content';
const d = home.discount;
const f = home.financing;
---
<section class="section on-stone" aria-label="Discount and financing">
  <div class="wrap amenities-grid">
    <div class="amenity">
      <h2>{d.title}</h2>
      <p class="lead">{d.text}</p>
      <a class="btn btn-stone" href="#quote">{d.linkLabel}</a>
    </div>
    <div class="amenity">
      <h2>{f.title}</h2>
      <p class="lead">{f.text}</p>
      <a class="btn btn-line" href={f.href}>{f.linkLabel}</a>
      <p class="partners-title muted">{f.partnersTitle}</p>
      <ul class="chips">
        {f.partners.map((p) => <li>{p.href ? <a href={p.href} rel="noopener">{p.label}</a> : <span class="chip-plain">{p.label}</span>}</li>)}
      </ul>
    </div>
  </div>
</section>
