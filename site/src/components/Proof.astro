---
import Icon from './Icon.astro';
import { home } from '../lib/content';
const p = home.proof;
---
<section class="proof section" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="proof-heading">
      <h2 id="proof-title">{p.title}</h2>
      <div class="google">
        <strong><Icon name="check" />{p.google.title}</strong>
        <p>{p.google.text}</p>
      </div>
    </div>
    <figure class="featured">
      <blockquote>
        <p class="q">“{p.featured.quote}”</p>
        <div class="featured-foot">
          <cite>{p.featured.by}</cite>
          <p class="more">{p.featured.more}</p>
        </div>
      </blockquote>
    </figure>
    <div class="reviews">
      {p.reviews.map((r) => (
        <figure class="review">
          <blockquote><p>“{r.quote}”</p></blockquote>
          <cite>{r.by}</cite>
        </figure>
      ))}
    </div>
  </div>
</section>
