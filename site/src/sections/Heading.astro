---
interface Props { label?: string; title?: string; titleEm?: string; intro?: string; anchor?: string; headingId: string }
const { label = '', title = '', titleEm = '', intro = '', anchor, headingId } = Astro.props;
---
<header class="page-shell blog-index__hero" id={anchor || undefined}>
  <p class="section-label">{label}</p>
  <h1 id={headingId}>{title}{' '}<br /><em>{titleEm}</em></h1>
  <p>{intro}</p>
</header>
