---
import EstimatorCard from '../components/EstimatorCard.astro';
import Lines from '../components/Lines.astro';
import LenderCard, { type Lender } from '../components/LenderCard.astro';

interface Props {
  label?: string; title?: string; titleEm?: string; intro?: string; note?: string;
  amount?: number; rate?: number; years?: number; background?: string; cta?: string; ctaHref?: string; anchor?: string; headingId: string;
  slogan?: string; lendersLabel?: string; lendersTitle?: string; lendersIntro?: string; lenders?: Lender[];
}
const { label = '', title = '', titleEm = '', intro = '', note = '', amount = 68000, rate = 6, years = 20, background = 'sand', slogan = '', cta = '', ctaHref = '#quote', anchor, headingId, lendersLabel = '', lendersTitle = '', lendersIntro = '', lenders = [] } = Astro.props;
---
<section class:list={['estimator', 'section', { 'estimator--white': background === 'white' }]} id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell">
    <div class="estimator__heading">
      <p class="section-label">{label}</p>
      <h2 id={headingId}><Lines text={title} />{titleEm && <Fragment>{' '}<em>{titleEm}</em></Fragment>}</h2>
      <p>{intro}</p>
    </div>
    <div class="estimator__layout">
    <div class="estimator__card">
      <EstimatorCard amount={amount} rate={rate} years={years} note={note} slogan={slogan} cta={cta} ctaHref={ctaHref} headingId={headingId} />
    </div>
    {lenders.length > 0 && (
      <aside class="estimator__lenders" aria-labelledby={`${headingId}-lenders`}>
        {lendersLabel && <p class="section-label section-label--light">{lendersLabel}</p>}
        <h3 id={`${headingId}-lenders`}>{lendersTitle}</h3>
        {lendersIntro && <p>{lendersIntro}</p>}
        <div class="estimator__lender-list">
          {lenders.map((lender, index) => <LenderCard lender={lender} index={index} level="h4" />)}
        </div>
      </aside>
    )}
    </div>
  </div>
</section>
