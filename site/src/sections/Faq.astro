---
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';

interface Question { question?: string; answer?: string; linkLabel?: string; linkHref?: string }
interface Props { label?: string; title?: string; titleEm?: string; questions?: Question[]; cta?: string; ctaHref?: string; twoColumns?: boolean; collapsible?: boolean; anchor?: string; headingId: string }
const { label = '', title = '', titleEm = '', questions = [], cta = '', ctaHref = '#quote', twoColumns = false, collapsible = false, anchor, headingId } = Astro.props;
---
<section class:list={['faq', 'section', { 'faq--wide': twoColumns }]} id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell faq__grid">
    <div class="faq__intro">
      <p class="section-label">{label}</p>
      <h2 id={headingId}><Lines text={title} />{titleEm && <Fragment>{' '}<em>{titleEm}</em></Fragment>}</h2>
      {cta && (
        <a class="button button--dark" href={ctaHref}>
          <span class="button__label">{cta}</span>
          <span class="button__wash" aria-hidden="true"></span>
          <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
        </a>
      )}
    </div>
    <div class="faq__list">
      {questions.map((item) => {
        const link = item.linkLabel && item.linkHref && <a class="text-link faq__link" href={item.linkHref}>{item.linkLabel} <Icon name="arrow-up-right" size={17} strokeWidth={1.6} /></a>;
        // A collapsible list keeps every answer in the page; only the opening and closing is hidden.
        return collapsible ? (
          <details class="faq__item faq__item--toggle">
            <summary><h3>{item.question}</h3><span class="faq__toggle" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{item.answer}</p>{link}</div>
          </details>
        ) : (
          <div class="faq__item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
            {link}
          </div>
        );
      })}
    </div>
  </div>
</section>
