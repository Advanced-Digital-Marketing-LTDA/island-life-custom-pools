---
interface Props {
  label?: string; title?: string; titleEm?: string; lede?: string; image?: string; imageAlt?: string; caption?: string;
  services?: { id?: string; title?: string; description?: string }[]; details?: string; anchor?: string; headingId: string;
}
const { label = '', title = '', titleEm = '', lede = '', image = '', imageAlt = '', caption = '', services = [], details = '', anchor, headingId } = Astro.props;
---
<section class="studio section" id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell studio__grid">
    <div class="studio__statement">
      <p class="section-label">{label}</p>
      <h2 id={headingId}>{title}{' '}<br /><em>{titleEm}</em></h2>
      <p class="studio__lede">{lede}</p>
    </div>
    <figure class="studio__image-wrap">
      {image && <img src={image} alt={imageAlt} loading="lazy" />}
      <figcaption>{caption}</figcaption>
    </figure>
    <div class="studio__services">
      {services.map((service, index) => (
        <div class="service-row" id={service.id || undefined}>
          <span class="service-row__index">0{index + 1}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))}
      <p class="studio__details">{details}</p>
    </div>
  </div>
</section>
