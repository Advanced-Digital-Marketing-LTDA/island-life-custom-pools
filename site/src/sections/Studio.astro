---
import Icon from '../components/Icon.astro';
import Lines from '../components/Lines.astro';
import { settings } from '../lib/content';

interface Props {
  label?: string; title?: string; titleEm?: string; lede?: string; image?: string; imageAlt?: string; caption?: string;
  services?: { id?: string; title?: string; description?: string; href?: string }[]; details?: string; areasLabel?: string; cta?: string; ctaHref?: string; anchor?: string; headingId: string;
}
const { label = '', title = '', titleEm = '', lede = '', image = '', imageAlt = '', caption = '', services = [], details = '', areasLabel = '', cta = '', ctaHref = '#quote', anchor, headingId } = Astro.props;
---
<section class="studio section" id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell studio__grid">
    <div class="studio__statement">
      <p class="section-label">{label}</p>
      <h2 id={headingId}><Lines text={title} />{' '}<br /><em>{titleEm}</em></h2>
      <p class="studio__lede">{lede}</p>
      {cta && (
        <a class="button button--dark" href={ctaHref}>
          <span class="button__label">{cta}</span>
          <span class="button__wash" aria-hidden="true"></span>
          <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
        </a>
      )}
    </div>
    <figure class="studio__image-wrap">
      {image && <img src={image} alt={imageAlt} loading="lazy" />}
      <figcaption>{caption}</figcaption>
    </figure>
    <div class="studio__services">
      {services.map((service, index) => (
        <div class="service-row" id={service.id || undefined}>
          <span class="service-row__index">0{index + 1}</span>
          <h3>{service.href ? <a href={service.href}>{service.title}</a> : service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))}
      <p class="studio__details">{details}</p>
      {areasLabel && settings.footer.areas.length > 0 && (
        <div class="studio__areas">
          <p class="section-label">{areasLabel}</p>
          <ul>{settings.footer.areas.map((area) => <li>{area.href ? <a href={area.href}>Pool builders in {area.name}</a> : area.name}</li>)}</ul>
        </div>
      )}
    </div>
  </div>
</section>
