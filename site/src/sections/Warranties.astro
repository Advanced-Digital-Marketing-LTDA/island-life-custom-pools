---
import Icon from '../components/Icon.astro';

// A single row of warranty promises under the calculator and quote form.
interface Props { items?: string[]; anchor?: string; headingId?: string }
const { items = [], anchor } = Astro.props;
---
{items.length > 0 && (
  <section class="warranties" id={anchor || undefined} aria-label="Our warranties">
    <ul class="page-shell warranties__list">
      {items.map((item) => (
        <li>
          <Icon name="shield-check" size={32} strokeWidth={1.5} />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>
)}
