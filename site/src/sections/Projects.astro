---
import Icon from '../components/Icon.astro';

interface Props {
  label?: string; title?: string; titleEm?: string; intro?: string;
  cards?: { layout?: string; name?: string; category?: string; detail?: string; image?: string; alt?: string }[];
  video?: string; videoPoster?: string; videoLabel?: string; cta?: string; ctaHref?: string; anchor?: string; headingId: string;
}
const { label = '', title = '', titleEm = '', intro = '', cards = [], video = '', videoPoster = '', videoLabel = '', cta = '', ctaHref = '#quote', anchor, headingId } = Astro.props;
---
<section class="projects section" id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell">
    <div class="projects__heading">
      <p class="section-label">{label}</p>
      <h2 id={headingId}>{title}{' '}<br /><em>{titleEm}</em></h2>
      <p>{intro}</p>
    </div>
    {video ? (
      // With a video, it takes the place of the photos. With a poster the browser downloads nothing until play is pressed;
      // without one it loads the first frame instead (about 13 MB for a large file).
      <div class="projects__video">
        <video controls playsinline preload={videoPoster ? 'none' : 'metadata'} poster={videoPoster || undefined} src={videoPoster ? video : `${video}#t=1`} aria-label={videoLabel || undefined}></video>
      </div>
    ) : (
    <div class="projects__grid">
      {cards.map((item) => (
        <figure class={`project project--${item.layout || 'pool'}`}>
          <div class="project__image">
            {item.image && <img src={item.image} alt={item.alt} loading="lazy" />}
          </div>
          <figcaption>
            <div>
              <h3>{item.name}</h3>
              <p>{item.detail}</p>
            </div>
            <span>{item.category}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    )}
    {cta && (
      <div class="projects__cta">
        <a class="button button--dark" href={ctaHref}>
          <span class="button__label">{cta}</span>
          <span class="button__wash" aria-hidden="true"></span>
          <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
        </a>
      </div>
    )}
  </div>
</section>
