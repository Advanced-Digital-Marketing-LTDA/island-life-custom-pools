---
import Icon from '../components/Icon.astro';
import { posts } from '../lib/content';

interface Props { readLabel?: string; anchor?: string; headingId?: string }
const { readLabel = 'Read the article', anchor } = Astro.props;
---
<section class="page-shell blog-index__posts" id={anchor || undefined} aria-label="Latest articles">
  {posts.map((post) => (
    <article class="blog-card">
      <a class="blog-card__image" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
        <img src={post.image} alt="" loading="lazy" />
      </a>
      <div class="blog-card__copy">
        <p class="section-label">{post.category}</p>
        <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
        <p>{post.excerpt}</p>
        <a class="text-link" href={`/blog/${post.slug}/`}>{readLabel} <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </article>
  ))}
</section>
