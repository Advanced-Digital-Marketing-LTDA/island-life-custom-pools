---
import Icon from '../components/Icon.astro';
import { escapeHtml } from '../lib/content';

interface Props {
  image?: string; imageAlt?: string; video?: string; videoMobile?: string; videoPoster?: string; kicker?: string; line1?: string; line2?: string; line3?: string; intro?: string;
  cta?: string; ctaHref?: string; scrollLabel?: string; scrollHref?: string; foot?: string[]; scrim?: boolean;
  anchor?: string; headingId: string;
}
const {
  image = '', imageAlt = '', video = '', videoMobile = '', videoPoster = '', kicker = '', line1 = '', line2 = '', line3 = '', intro = '', cta = '', ctaHref = '#quote',
  scrollLabel = '', scrollHref = '', foot = [], scrim = false, anchor, headingId,
} = Astro.props;
---
<section class:list={['hero', { 'hero--video': !!video, 'hero--scrim': scrim }]} id={anchor || undefined} aria-labelledby={headingId}>
  {video ? (
    // The video is decoration: it plays muted and loops. Visitors who prefer reduced motion get the still instead (see the script).
    // MP4 comes first because it is the smaller file; WebM is for browsers without H.264. Phones get the smaller 720p files.
    <video class="hero__image" autoplay muted loop playsinline preload="metadata" poster={videoPoster || image} aria-hidden="true" tabindex="-1" data-alt={imageAlt} style="transform: translate3d(0px, 0%, 0px) scale(1.04);">
      {videoMobile && <source src={videoMobile} type="video/mp4" media="(max-width: 767px)" />}
      <source src={video} type="video/mp4" />
      {videoMobile && <source src={videoMobile.replace(/\.mp4$/, '.webm')} type="video/webm" media="(max-width: 767px)" />}
      <source src={video.replace(/\.mp4$/, '.webm')} type="video/webm" />
    </video>
  ) : (
    image && <img class="hero__image" src={image} alt={imageAlt} fetchpriority="high" style="transform: translate3d(0px, 0%, 0px) scale(1.04);" />
  )}
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__content page-shell" style="transform: translate3d(0px, 0px, 0px); opacity: 1;">
    <p class="hero__kicker">{kicker}</p>
    <h1 id={headingId} class="hero__title">
      <span>{line1}</span>{' '}
      <span><em>{line2}</em></span>{' '}
      <span>{line3}</span>
    </h1>
    <div class="hero__intro">
      <p>{intro}</p>
      <a class="button button--light" href={ctaHref}>
        <span class="button__label">{cta}</span>
        <span class="button__wash" aria-hidden="true"></span>
        <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
      </a>
    </div>
  </div>
  {(scrollHref || foot.length > 0) && (
    <div class="hero__foot page-shell">
      {scrollHref && (
        <a class="hero__scroll" href={scrollHref}>
          <Icon name="arrow-down" size={17} strokeWidth={1.5} />
          <span>{scrollLabel}</span>
        </a>
      )}
      {foot.length > 0 && <p set:html={foot.map(escapeHtml).join(' <span>·</span> ')} />}
    </div>
  )}
</section>

<script>
  // Parallax as the React site had it (framer-motion useScroll): progress runs from 0 when a hero's top
  // meets the viewport top to 1 when its bottom does, and drives four linear ranges.
  // framer fades the content with a native scroll timeline wherever ScrollTimeline exists, and that timeline
  // starts below the page's scroll-padding-top (76px), so the fade runs that much ahead of the transforms.
  // A hero video becomes its poster still for visitors who prefer reduced motion, as it did in the React site.
  const stillMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const swapVideoForStill = () => document.querySelectorAll<HTMLVideoElement>('video.hero__image').forEach((video) => {
    if (!stillMotion.matches) return;
    const still = document.createElement('img');
    still.className = 'hero__image';
    still.src = video.poster;
    still.alt = video.dataset.alt || '';
    still.setAttribute('fetchpriority', 'high');
    video.pause();
    video.replaceWith(still);
  });
  swapVideoForStill();
  stillMotion.addEventListener('change', swapVideoForStill);

  const heroes = [...document.querySelectorAll<HTMLElement>('.hero')].map((hero) => ({
    hero, image: hero.querySelector<HTMLElement>('.hero__image'), content: hero.querySelector<HTMLElement>('.hero__content')!,
  }));
  if (heroes.length) {
    const fadeInset = 'ScrollTimeline' in window ? parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0 : 0;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const clamp = (n: number) => Math.min(Math.max(n, 0), 1);
    const lerp = (progress: number, from: number, to: number) => from + (to - from) * progress;

    let frame = 0;
    const update = () => {
      frame = 0;
      if (reducedMotion.matches) return;
      for (const { hero, image, content } of heroes) {
        const { top, height } = hero.getBoundingClientRect();
        const progress = clamp(-top / height);
        if (image) image.style.transform = `translate3d(0px, ${lerp(progress, 0, 16)}%, 0px) scale(${lerp(progress, 1.04, 1.09)})`;
        content.style.transform = `translate3d(0px, ${lerp(progress, 0, -90)}px, 0px)`;
        content.style.opacity = String(1 - clamp((fadeInset - top) / height / 0.82));
      }
    };
    const request = () => { frame ||= requestAnimationFrame(update); };

    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
  }
</script>
