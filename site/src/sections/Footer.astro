---
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import { settings, linkTo } from '../lib/content';
import { homePrefix } from '../lib/nav';

interface Props { hasQuote?: boolean }
const { hasQuote = false } = Astro.props;
const { phone, phoneHref, footer } = settings;
const prefix = homePrefix(Astro.url);
// On a page with its own quote form, "#quote" stays on the page.
const target = (href: string) => (hasQuote && href === '#quote' ? href : linkTo(Astro.url, href));
---
<footer class="footer">
  <div class="page-shell footer__top">
    <div>
      <a class="footer__brand" href={`${prefix}#top`} aria-label={`${settings.name} home`}><Brand /></a>
      <p>{footer.blurbLine1}{' '}<br />{footer.blurbLine2}</p>
    </div>
    <nav aria-label="Footer navigation">
      {footer.nav.map((item) => <a href={target(item.href)}>{item.label}</a>)}
    </nav>
    <div class="footer__contact">
      <span>{footer.areasTitle}</span>
      <p>{footer.areas.map((area, index) => <Fragment>{index > 0 && <Fragment>{' '}<br /></Fragment>}{area.href ? <a href={area.href}>{area.name}</a> : area.name}</Fragment>)}</p>
    </div>
    <div class="footer__hours">
      <span>{footer.hoursTitle}</span>
      <p>{footer.hours.map((row, index) => <Fragment>{index > 0 && <Fragment>{' '}<br /></Fragment>}{row.days}{' '}<strong>{row.time}</strong></Fragment>)}</p>
      <a href={phoneHref}>{phone}</a>
      {settings.social.length > 0 && (
        <ul class="footer__social" aria-label="Island Life Custom Pools online">
          {settings.social.map((link) => <li><a href={link.href} target="_blank" rel="noopener">{link.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
        </ul>
      )}
    </div>
    <a class="footer__top-link" href={`${prefix}#top`} aria-label="Back to top">
      <Icon name="arrow-up" size={22} strokeWidth={1.4} />
    </a>
  </div>
  <div class="page-shell footer__bottom">
    <span>© <span data-year>{new Date().getFullYear()}</span> {footer.copyright}</span>
    <span>{footer.tagline}</span>
    {footer.credit && <span class="footer__credit">{footer.creditHref ? <a href={footer.creditHref} target="_blank" rel="noopener">{footer.credit}</a> : footer.credit}</span>}
  </div>
</footer>

<script>
  // The site is built ahead of time, so keep the year current in the browser.
  document.querySelector('[data-year]')!.textContent = String(new Date().getFullYear());
</script>
