---
interface Item { layout?: string; title?: string; category?: string; description?: string; image?: string; alt?: string; position?: string }
interface Props {
  label?: string; title?: string; titleEm?: string; intro?: string; linkLabel?: string; linkHref?: string; photos?: Item[];
  anchor?: string; headingId: string;
}
const { label = '', title = '', titleEm = '', intro = '', linkLabel = '', linkHref = '', photos = [], anchor, headingId } = Astro.props;
---
<section class="gallery-collection section" id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell">
    <div class="gallery-collection__intro">
      <p class="section-label">{label}</p>
      <h2 id={headingId}>{title}{' '}<br /><em>{titleEm}</em></h2>
      <p>{intro}{linkLabel && linkHref && <>{' '}<a href={linkHref}>{linkLabel}</a></>}</p>
    </div>

    <div class="gallery-collection__grid">
      {photos.map((item, index) => (
        <figure class={`gallery-item gallery-item--${item.layout || 'wide'}`}>
          <div class="gallery-item__image">
            {item.image && <img src={item.image} alt={item.alt} loading="lazy" decoding="async" style={`object-position: ${item.position || 'center'};`} />}
          </div>
          <figcaption>
            <span class="gallery-item__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="gallery-item__category">{item.category}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
