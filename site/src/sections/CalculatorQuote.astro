---
import EstimatorCard from '../components/EstimatorCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Lines from '../components/Lines.astro';
import { settings } from '../lib/content';

// The home page's first working section: the monthly payment calculator and the quote form side by side.
interface Props {
  title?: string; titleEm?: string; intro?: string; note?: string; slogan?: string;
  amount?: number; rate?: number; years?: number; anchor?: string; headingId: string;
}
const { title = '', titleEm = '', intro = '', note = '', slogan = '', amount = 68000, rate = 6, years = 20, anchor, headingId } = Astro.props;
const { phone, phoneHref, quote } = settings;
---
<section class="calc-quote section" id={anchor || undefined}>
  <div class="page-shell calc-quote__grid">
    <div class="calc-quote__card" aria-labelledby={headingId} role="group">
      <h2 id={headingId}><Lines text={title} />{titleEm && <Fragment>{' '}<em>{titleEm}</em></Fragment>}</h2>
      {intro && <p class="calc-quote__intro">{intro}</p>}
      <EstimatorCard amount={amount} rate={rate} years={years} note={note} slogan={slogan} headingId={headingId} />
    </div>
    <div class="calc-quote__card" aria-labelledby={`${headingId}-form`} role="group">
      <h2 id={`${headingId}-form`}>{quote.titleLine}{' '}<em>{quote.titleEm}</em></h2>
      <p class="calc-quote__intro">{quote.intro}</p>
      <QuoteForm surface="light" />
      <p class="calc-quote__call">{quote.callLabel} <a href={phoneHref}>{phone}</a></p>
    </div>
  </div>
</section>
