---
import Icon from '../components/Icon.astro';

interface Props { badgeLine1?: string; badgeLine2?: string; title?: string; text?: string; cta?: string; ctaHref?: string; anchor?: string; headingId: string }
const { badgeLine1 = '', badgeLine2 = '', title = '', text = '', cta = '', ctaHref = '#quote', anchor, headingId } = Astro.props;
---
<section class="trust" id={anchor || undefined} aria-labelledby={headingId}>
  <div class="page-shell trust__grid">
    <div class="trust__badge">
      <Icon name="shield-check" size={54} strokeWidth={1.25} />
      <p>{badgeLine1}{badgeLine2 && <Fragment>{' '}<br />{badgeLine2}</Fragment>}</p>
    </div>
    <div class="trust__copy">
      <h2 id={headingId}>{title}</h2>
      <p>{text}</p>
      {cta && (
        <a class="button button--dark" href={ctaHref}>
          <span class="button__label">{cta}</span>
          <span class="button__wash" aria-hidden="true"></span>
          <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
        </a>
      )}
    </div>
  </div>
</section>
