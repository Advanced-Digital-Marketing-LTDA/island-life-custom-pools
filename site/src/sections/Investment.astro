---
import Icon from '../components/Icon.astro';
import { home } from '../lib/content';

const { investment } = home;
---
<section class="investment section" id="financing" aria-labelledby="investment-title">
  <div class="page-shell investment__grid">
    <div class="investment__intro">
      <p class="section-label section-label--light">{investment.label}</p>
      <h2 id="investment-title">{investment.title}{' '}<br /><em>{investment.titleEm}</em></h2>
      <p>{investment.intro}</p>
      <div class="investment__partners" aria-label="Product partners">
        <span>{investment.partnersLabel}</span>
        <p>{investment.partners.join(" · ")}</p>
      </div>
    </div>
    <div class="investment__offer">
      <p class="investment__price"><span>{investment.offerLabel}</span>{investment.offerLine1}{' '}<br />{investment.offerLine2}</p>
      <ul>
        {investment.possibilities.map((item) => (
          <li><Icon name="check" size={18} strokeWidth={1.6} />{item}</li>
        ))}
      </ul>
      <p class="investment__note">{investment.note}</p>
      <p class="investment__discount"><strong>{investment.discountTitle}</strong> {investment.discountText}</p>
      <a class="button button--dark" href="#quote">
        <span class="button__label">{investment.cta}</span>
        <span class="button__wash" aria-hidden="true"></span>
        <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
      </a>
    </div>
  </div>
</section>
