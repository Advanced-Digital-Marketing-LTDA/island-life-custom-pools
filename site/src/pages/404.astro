---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Footer from '../sections/Footer.astro';
import { settings } from '../lib/content';
---
<Base title={`Page not found | ${settings.name}`} description="That page doesn’t exist, or it moved." noindex>
  <Header solid />
  <main id="top" class="blog-index">
    <header class="page-shell blog-index__hero">
      <p class="section-label">Page not found</p>
      <h1>That page{' '}<br /><em>moved on.</em></h1>
      <p>It doesn’t exist, or it has a new address. Start from the home page and we’ll point you to the right place.</p>
    </header>
    <section class="page-shell blog-index__posts" aria-label="Next step">
      <a class="button button--dark" href="/">
        <span class="button__label">Go to the home page</span>
        <span class="button__wash" aria-hidden="true"></span>
        <Icon name="arrow-up-right" size={18} strokeWidth={1.7} />
      </a>
    </section>
  </main>
  <Footer />
</Base>
