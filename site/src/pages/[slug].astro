---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Design3D from '../components/Design3D.astro';
import Proof from '../components/Proof.astro';
import Services from '../components/Services.astro';
import Financing from '../components/Financing.astro';
import Discount from '../components/Discount.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';
import pages from '../../content/pages.json';
import { home } from '../lib/content';
import '../styles/inner.css';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: any };
const has = (s: string) => page.sections.includes(s);
---
<Base title={page.seoTitle} description={page.seoDescription} noindex={page.noindex}>
  <Header />
  <main id="content">
    <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: page.title }]} eyebrow={page.eyebrow} title={page.title} lead={page.lead} image={page.image} imageAlt={page.imageAlt} actions={page.actions !== false} />
    {has('overview') && (
      <section class="overview">
        <div class="wrap overview-grid">
          <div class="overview-copy">
            <h2>Designed around your yard</h2>
            {page.body.map((p: string) => <p>{p}</p>)}
          </div>
          <img class="overview-img" src={page.image2 ?? page.image} alt={page.image2Alt ?? page.imageAlt} loading="lazy" width="1280" height="720" />
        </div>
      </section>
    )}
    {has('services') && <Services />}
    {has('gallery') && (
      <section class="gallery" aria-label="3D design visualizations">
        <div class="wrap">
          <ul class="gallery-grid">
            {page.gallery.map(([file, alt]: string[]) => (
              <li><figure><img src={`/media/${file}`} alt={`${alt} in an Island Life 3D backyard design`} loading="lazy" width="1280" height="720" /><figcaption>3D design visualization</figcaption></figure></li>
            ))}
          </ul>
        </div>
      </section>
    )}
    {has('financing') && <Financing />}
    {has('partners') && (
      <section class="overview">
        <div class="wrap">
          <div class="partners partners-page">
            <h2>{home.financing.partnersTitle}</h2>
            <ul>
              {home.financing.partners.filter((p) => p.href).map((p) => <li><a href={p.href} rel="noopener">{p.label}<Icon name="out" /></a></li>)}
            </ul>
          </div>
        </div>
      </section>
    )}
    {has('prose') && (
      <section class="article">
        <div class="wrap"><div class="prose">{page.prose.map((p: string) => <p>{p}</p>)}</div></div>
      </section>
    )}
    {has('process') && <Process steps={page.processSteps} />}
    {has('design') && <Design3D />}
    {has('proof') && <Proof />}
    {has('cta') && <Discount />}
    {has('quote') && <Quote />}
  </main>
  <Footer />
  <MobileBar />
</Base>
