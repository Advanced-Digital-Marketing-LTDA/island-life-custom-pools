---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Discount from '../../components/Discount.astro';
import Footer from '../../components/Footer.astro';
import MobileBar from '../../components/MobileBar.astro';
import { posts, fmtDate } from '../../lib/blog';
import '../../styles/inner.css';
const [lead, ...rest] = posts;
---
<Base title="Blog | Island Life Custom Pools" description="Pool, patio and outdoor kitchen ideas from Island Life Custom Pools in the Houston area.">
  <Header />
  <main id="content">
    <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} title="Blog" lead="Articles on pools, patios and outdoor kitchens." actions={false} />
    <section class="blog">
      <div class="wrap">
        {lead && (
          <a class="post-lead" href={`/blog/${lead.slug}/`}>
            <img src={lead.image} alt={lead.imageAlt} width="1280" height="720" />
            <span class="post-lead-copy">
              <span class="post-meta">{fmtDate(lead.date)} · {lead.minutes} min read</span>
              <h2>{lead.title}</h2>
              <p>{lead.excerpt}</p>
              <span class="post-more">Read the article</span>
            </span>
          </a>
        )}
        <ul class="post-grid">
          {rest.map((p) => (
            <li>
              <a class="post-card" href={`/blog/${p.slug}/`}>
                <img src={p.image} alt={p.imageAlt} loading="lazy" width="1280" height="720" />
                <span class="post-meta">{fmtDate(p.date)} · {p.minutes} min read</span>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <Discount title="Start with a free design consult" text="Tell us what you want and what you must have. We listen first." quoteHref="/#quote" />
  </main>
  <Footer />
  <MobileBar />
</Base>
