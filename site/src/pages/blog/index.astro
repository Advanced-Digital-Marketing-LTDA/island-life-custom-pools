---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../sections/Footer.astro';
import { blog, posts } from '../../lib/content';
---
<Base title={blog.seoTitle} description={blog.seoDescription}>
  <Header solid />
  <main id="top" class="blog-index">
    <header class="page-shell blog-index__hero">
      <p class="section-label">{blog.label}</p>
      <h1>{blog.title}{' '}<br /><em>{blog.titleEm}</em></h1>
      <p>{blog.intro}</p>
    </header>
    <section class="page-shell blog-index__posts" aria-label="Latest articles">
      {posts.map((post) => (
        <article class="blog-card">
          <a class="blog-card__image" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
            <img src={post.image} alt="" loading="lazy" />
          </a>
          <div class="blog-card__copy">
            <p class="section-label">{post.category}</p>
            <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
            <a class="text-link" href={`/blog/${post.slug}`}>{blog.readLabel} <Icon name="arrow-up-right" size={18} /></a>
          </div>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Base>
