---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Paths from '../components/Paths.astro';
import Design3D from '../components/Design3D.astro';
import Circuit from '../components/Circuit.astro';
import Process from '../components/Process.astro';
import Proof from '../components/Proof.astro';
import Financing from '../components/Financing.astro';
import Recent from '../components/Recent.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Wayfinder from '../components/Wayfinder.astro';
---
<Base>
  <Header />
  <main id="content">
    <Hero />
    <Design3D />
    <Circuit />
    <Paths />
    <Process />
    <Proof />
    <Financing />
    <Recent />
    <Quote />
  </main>
  <Footer />
  <MobileBar />
  <Wayfinder />
</Base>
