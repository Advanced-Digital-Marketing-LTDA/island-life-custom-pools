---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../sections/Hero.astro';
import Studio from '../sections/Studio.astro';
import Projects from '../sections/Projects.astro';
import Testimonial from '../sections/Testimonial.astro';
import Process from '../sections/Process.astro';
import Investment from '../sections/Investment.astro';
import Estimate from '../sections/Estimate.astro';
import Footer from '../sections/Footer.astro';
import { home } from '../lib/content';
---
<Base title={home.seoTitle} description={home.seoDescription} preloadHero>
  <Header />
  <main>
    <Hero />
    <Studio />
    <Projects />
    <Testimonial />
    <Process />
    <Investment />
    <Estimate />
  </main>
  <Footer />
</Base>
