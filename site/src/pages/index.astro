---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Paths from '../components/Paths.astro';
import Design3D from '../components/Design3D.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import Discount from '../components/Discount.astro';
import Proof from '../components/Proof.astro';
import Recent from '../components/Recent.astro';
import Financing from '../components/Financing.astro';
import Quote from '../components/Quote.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---
<Base>
  <Header />
  <main id="content">
    <Hero />
    <Services />
    <Paths />
    <Design3D />
    <Financing />
    <Process />
    <div class="duo" aria-hidden="true">
      <img src="/media/design-grotto-pool.webp" alt="" loading="lazy" width="1280" height="720" />
      <img src="/media/design-spa-pavilion.webp" alt="" loading="lazy" width="1280" height="720" />
    </div>
    <Proof />
    <Recent />
    <Discount />
    <Quote />
  </main>
  <Footer />
  <MobileBar />
</Base>
