---
import '@fontsource-variable/figtree';
import figtreeUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { settings, home } from '../lib/content';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = home.seoTitle, description = home.seoDescription, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const logoIsSvg = settings.logo.endsWith('.svg');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: settings.name,
  url: Astro.site?.href,
  telephone: settings.phone,
  description,
  areaServed: settings.areas.map((a) => a.label),
  sameAs: settings.social.filter((s) => !s.label.toLowerCase().includes('review')).map((s) => s.href),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" as="font" type="font/woff2" crossorigin href={figtreeUrl} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/media/hero-poster.webp', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={settings.logo} type={logoIsSvg ? 'image/svg+xml' : 'image/webp'} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
