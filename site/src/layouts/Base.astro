---
import '../styles/index.css';
import '../styles/app.css';
import SmoothScroll from '../components/SmoothScroll.astro';
import { settings, pages } from '../lib/content';
import { services } from '../lib/services';

interface Props { title: string; description: string; preload?: string; noindex?: boolean; extraLd?: object[] }
const { title, description, preload, noindex = false, extraLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(settings.ogImage, Astro.site).href;
// The business description is the same on every page: the home page's.
const businessDescription = pages.find((page) => page.slug === '')?.seoDescription || description;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${Astro.site?.href}#business`,
  name: settings.name,
  url: Astro.site?.href,
  logo: new URL(settings.logo, Astro.site).href,
  image: ogImage,
  telephone: settings.phone,
  description: businessDescription,
  alternateName: 'Island Life Pools',
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Greater Houston, TX' }, ...settings.footer.areas.map((area) => ({ '@type': 'City', name: `${area.name}, TX` }))],
  ...(settings.ownerName ? { employee: { '@type': 'Person', name: settings.ownerName, jobTitle: settings.ownerRole || 'Owner' } } : {}),
  ...(settings.foundingDate ? { foundingDate: settings.foundingDate } : {}),
  ...(settings.awards.length ? { award: settings.awards } : {}),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((service) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: service.name, url: new URL(`/${service.slug}/`, Astro.site).href } })),
  },
  sameAs: settings.social.filter((link) => !link.label.toLowerCase().includes('review')).map((link) => link.href),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0290fc" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <link rel="preload" as="font" href="/fonts/michroma-regular.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/montserrat-regular.woff2" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {extraLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <title>{title}</title>
  </head>
  <body>
    <div id="root">
      <a class="skip-link" href="#top">Skip to main content</a>
      <SmoothScroll />
      <slot />
    </div>
    <script>
      // Lenis intercepts in-page links and scrolls itself, so move keyboard focus to the content explicitly.
      document.querySelector('.skip-link')!.addEventListener('click', () => {
        const target = document.getElementById('top');
        if (!target) return;
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
