---
import '../styles/index.css';
import '../styles/app.css';
import SmoothScroll from '../components/SmoothScroll.astro';
import { home, settings } from '../lib/content';

interface Props { title: string; description: string; preloadHero?: boolean; noindex?: boolean }
const { title, description, preloadHero = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(home.hero.image, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: settings.name,
  url: Astro.site?.href,
  telephone: settings.phone,
  description,
  areaServed: settings.footer.areas.map((area) => `${area}, TX`),
  sameAs: settings.social.filter((link) => !link.label.toLowerCase().includes('review')).map((link) => link.href),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#18334a" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadHero && <link rel="preload" as="image" href={home.hero.image} fetchpriority="high" />}
    <link rel="preload" as="font" href="/fonts/michroma-regular.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/montserrat-regular.woff2" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <title>{title}</title>
  </head>
  <body>
    <div id="root">
      <SmoothScroll />
      <slot />
    </div>
  </body>
</html>
