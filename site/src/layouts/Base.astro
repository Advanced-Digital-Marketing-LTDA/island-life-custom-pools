---
import '@fontsource/marcellus';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { settings, home } from '../lib/content';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = home.seoTitle, description = home.seoDescription, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const logoUrl = new URL(settings.logo, Astro.site).href;
const logoIsSvg = settings.logo.endsWith('.svg');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: settings.name,
  url: Astro.site?.href,
  telephone: settings.phone,
  description,
  areaServed: settings.areas.map((a) => a.label),
  sameAs: settings.social.filter((s) => !s.label.toLowerCase().includes('review')).map((s) => s.href),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#06384a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {!logoIsSvg && <meta property="og:image" content={logoUrl} />}
    <link rel="icon" href={settings.logo} type={logoIsSvg ? 'image/svg+xml' : 'image/webp'} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <!--
    THESIS: A spa-day circuit through your future backyard (Plunge, Lounge, Table, Fire, then the quote), refusing the aqua-photo hero over a white card grid.
    OWN-WORLD: Deep lagoon ground, honed-stone plaques with brass inset rules and numbered brass medallions, soft pool-floor light glows, Marcellus inscription type; photos and video carry all the color.
    STORY: In Houston heat the visitor finds a cool oasis, learns Island Life models the yard in 3D before building the rooms, then calls or requests a quote.
    FIRST VIEWPORT: Full-bleed looping 3D flythrough under drifting steam, stone logo plate and nav on top, headline lower-left at display scale, brass quote and stone call buttons equal beneath the lead, a four-room route strip, then pause control and trust line at the foot.
    FORM: Thermal spa circuit wayfinding, candidate 4 of 7 (re-roll 2), seed key 7edb5630.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
