# Build settings, loaded from .env.
SITE_URL=http://localhost:4321
SOURCE_COMMIT=local
# Server settings: export for npm start; use runtime variables in Coolify.
HOST=0.0.0.0
PORT=4321
# Quote form email (Proton SMTP). Runtime secrets: set them in Coolify, never commit real values.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=
SMTP_TOKEN=
LEAD_TO=
# Tina Cloud editor (/admin). Set all three as build variables in Coolify; without them the image has no editor.
TINA_CLIENT_ID=
TINA_TOKEN=
GITHUB_BRANCH=main
